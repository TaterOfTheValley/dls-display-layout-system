# Build intermediates — regenerated by `dotnet build`, never worth versioning.
bin/
obj/

# dist/ is intentionally NOT ignored: with no CI or release pipeline, the checked-in
# binary in dist/ is how this app is distributed.

# Local profile data. Machine-specific: it holds this PC's monitor device paths.
profiles.json

# Diagnostic captures
*.user

# Debug symbols for the distributed build.
dist/*.pdb
