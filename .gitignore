# Build intermediates — regenerated by `dotnet build`, never worth versioning.
bin/
obj/

# Local publish output. Releases are built by .github/workflows/release.yml from a
# version tag and attached to the GitHub release, so a binary in the repo would only
# ever be a stale copy of one.
dist/
ci-publish/
ci-pack/
ci-tools/

# Local profile data. Machine-specific: it holds this PC's monitor device paths.
profiles.json

# Diagnostic captures
*.user
